# Unreal-generated local data (works with a project at root or below it)
Intermediate/
Saved/
DerivedDataCache/
Binaries/

# Vendor plugins may require binaries that cannot be rebuilt from source.
# Review these individually; add narrow ignores for generated source-plugin binaries.
!**/Plugins/**/Binaries/
!**/Plugins/**/Binaries/**

# Do not ignore shared Config/, Content/, Source/, Plugins/, or Build/ resources.
# ...except files Unreal rewrites on every package (open-order logs, version counter).
**/Build/*/FileOpenOrder/
**/Build/*/*.PackageVersionCounter

# IDE and editor state, regenerated project files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.code-workspace
*.swp
*.swo
*~

# Blender automatic backups; keep editable .blend sources
*.blend[0-9]*
*.blend@

# Package outside the checkout; fallback output directories only
PackagedBuilds/
StagedBuilds/
dist/

# Python environment for the offline tools (Tools/blender/voxtex.py, the tests, compare.py, sheet.py)
Tools/.venv/
__pycache__/

# OS metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local assistant/MCP configuration and workspaces
.mcp.json
.claude/settings.local.json
.claude/local/
.claude/worktrees/

# Secrets and personal overrides; portable examples may be committed after review
.env
.env.*
!.env.example
!.env.*.example
*.local.ini
*.local.json
*.pem
*.key
*.p12
*.pfx
Builds/

# Generated by the scripts (Tools/blender/*, sh Tools/blender/build_all.sh) and too large for the repo
SourceArt/Meshes/*.gltf
SourceArt/Meshes/*.bin
SourceArt/Meshes/LOD/*.gltf
SourceArt/Meshes/LOD/*.bin
SourceArt/Previews/
SourceArt/Audio/Raw/
# The soundtrack's sources (~360 MB); the imported Content/Voxel/Audio/S_Music_* assets are tracked
SourceArt/Audio/S_Music_*.wav
