// The launcher's art, bundled in the exe. Tools/windows/build_launcher.ps1 gathers these files next to a copy of
// this script (Intermediate/Launcher) and runs rc.exe there: the SourceArt/UI PNGs, the engine's Roboto, and the
// emblem as the icon.
#include "resource.h"

IDI_APP            ICON   "app.ico"
IDR_KING_RUN       RCDATA "T_UI_KingRun.png"
IDR_KING_CROUCH    RCDATA "T_UI_KingCrouchRun.png"
IDR_RUNNER_PROPS   RCDATA "T_UI_RunnerProps.png"
IDR_EMBLEM         RCDATA "T_UI_Emblem.png"
IDR_ROBOTO_BOLD    RCDATA "Roboto-Bold.ttf"
IDR_ROBOTO_REGULAR RCDATA "Roboto-Regular.ttf"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Sovereign Realms"
      VALUE "ProductName", "Sovereign Realms"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
