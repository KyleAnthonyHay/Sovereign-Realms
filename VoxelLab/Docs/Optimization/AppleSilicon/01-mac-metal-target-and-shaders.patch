diff --git a/Config/DefaultEngine.ini b/Config/DefaultEngine.ini
index 0aa3b44..2213c04 100644
--- a/Config/DefaultEngine.ini
+++ b/Config/DefaultEngine.ini
@@ -13,6 +13,11 @@ r.DefaultFeature.MotionBlur=False
 r.AllowStaticLighting=False
 ; the hero renders custom depth so that M_Silhouette can show him through trees and buildings
 r.CustomDepth=3
+; VoxelLab uses no MegaLights and no DBuffer decals. Disabling MegaLights omits ~22 MB of unused SM6 compute
+; shaders from the cook; disabling DBuffer removes decal base-pass fetches, shader permutations, and one of the
+; triggers that forces a full depth prepass.
+r.MegaLights.Supported=False
+r.DBuffer=False
 
 [SystemSettings]
 r.Tonemapper.Sharpen=0.6
diff --git a/Config/Mac/MacEngine.ini b/Config/Mac/MacEngine.ini
index 8d8d74d..f11ee55 100644
--- a/Config/Mac/MacEngine.ini
+++ b/Config/Mac/MacEngine.ini
@@ -2,3 +2,41 @@
 ; and old GPUs, which this game's renderer - Lumen, virtual shadow maps - does not run on anyway).
 [/Script/MacTargetPlatform.MacTargetSettings]
 -TargetedRHIs=SF_METAL_SM5
+; Metal 3.0 (macOS 13.0+): unlocks Metal 3 shader compiler codegen instead of the UE 5.8 default Metal 2.4 (7).
+MetalLanguageVersion=8
+; Lock all Mac targets (local, CI, Distribution) to Apple Silicon arm64 so universal fat binaries are never emitted.
+TargetArchitecture=MacTargetArchitectureAppleSilicon
+EditorTargetArchitecture=MacTargetArchitectureAppleSilicon
+DefaultArchitecture=MacTargetArchitectureAppleSilicon
+bBuildAllSupportedOnBuildMachine=False
+; VoxelLab does not use Hardware Ray Tracing; BaseEngine.ini defaults this to True + Full, which cooks 1,243 unused
+; RT shaders (23.70 MB uncompressed in METAL_SM6).
+bEnableRayTracing=False
+RayTracingMode=Disabled
+; Run metal-strip -T on individual metallibs during cook to trim shader metadata.
+StripIndividualMetalLibs=True
+
+[TextureStreaming]
+; BaseMacEngine.ini sets PoolSizeVRAMPercentage=70 (4-12 GB on unified-memory Macs). VoxelLab's textures are ~0.5 MB
+; and non-streaming; cap the streaming pool explicitly so unified-memory budgets stay realistic on 8-16 GB MacBooks.
+PoolSizeVRAMPercentage=0
+
+[SystemSettings]
+r.Streaming.PoolSize=256
+; UE 5.8 MetalDevice.cpp accidentally initializes GMetalResourcePurgeOnDelete=1 (comment says Default: 0, Off).
+; Disabling it avoids setPurgeableState() driver/kernel overhead on every transient buffer/texture release.
+rhi.Metal.ResourcePurgeOnDelete=0
+; Keep metallib file mappings persistent to avoid repeated mmap/unmap overhead during shader/PSO loading.
+r.Metal.PersistentMappingMetallib=1
+; Metal PSO precaching: compile global and component PSOs ahead of time and retain them bounded in memory to avoid
+; first-sight frame hitches when new troops, combat effects, or buildings enter view.
+r.PSOPrecaching=1
+r.PSOPrecache.GlobalShaders=1
+r.PSOPrecache.ProxyCreationStrategy=1
+r.PSOPrecache.KeepInMemoryUntilUsed=1
+r.PSOPrecache.KeepInMemoryGraphicsMaxNum=2048
+r.PSOPrecache.KeepInMemoryComputeMaxNum=512
+
+[/Script/Engine.PSOPrecacheSettingsManager]
+; BaseEngine.ini defines entries for PCD3D_SM6 and mobile ES3_1, but omits METAL_SM6.
++Settings=(ShaderPlatform="METAL_SM6", MaxCPUThreadCount=255, GlobalShaderMode=1)
