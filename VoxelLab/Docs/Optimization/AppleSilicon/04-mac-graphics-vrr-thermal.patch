+const TCHAR* UVLGraphics::DynamicResName(int32 Mode)
+{
+	static const TCHAR* Names[NumDynRes] = { TEXT("Off"), TEXT("Target 60 fps"), TEXT("Target 40 fps"), TEXT("Target 30 fps") };
